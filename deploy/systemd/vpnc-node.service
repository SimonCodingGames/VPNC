[Unit]
Description=VPNC Node Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/vpnc/node.env
ExecStart=/usr/local/bin/vpnc-node run
Restart=on-failure
RestartSec=3
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/vpnc /var/lib/vpnc
PrivateTmp=true

[Install]
WantedBy=multi-user.target
