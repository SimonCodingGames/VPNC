# syntax=docker/dockerfile:1
# Cargo.lock needs rustc >= 1.89 (uuid 1.29). Track current stable (rust-toolchain.toml).
FROM rust:1.99.1-bookworm AS build
WORKDIR /src
COPY . .
RUN cargo build --release -p vpnc-control

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=build /src/target/release/vpnc-control /usr/local/bin/vpnc-control
EXPOSE 8080 50051
ENTRYPOINT ["vpnc-control"]
